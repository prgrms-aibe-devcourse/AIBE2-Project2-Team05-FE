# TravelMate React 19 + TypeScript + Spring Boot 프로젝트
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage
*.lcov
.nyc_output

# Production builds
/build
/dist
*.tgz
*.tar.gz

# Environment variables
.env
.env.production

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Icon?

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# TypeScript
*.tsbuildinfo
.tscache/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Storybook build outputs
.out
.storybook-out
storybook-static

# Temporary folders
tmp/
temp/

# React specific
.eslintcache

# Styled Components
.styled-components/

# Backup files
*.backup
*.bak

# ================================
# Taskmaster 관련
# ================================

# Taskmaster 개인 작업 파일들 (선택적으로 제외)
.taskmaster/tasks/
.taskmaster/reports/
.taskmaster/state.json
*/.taskmaster/tasks/
*/.taskmaster/reports/
*/.taskmaster/state.json

# Taskmaster 설정은 팀과 공유 (포함)
!.taskmaster/config.json
!.taskmaster/templates/
!.taskmaster/docs/

# 개별 태스크 파일들
*.taskmaster.json
*.tm.json

# Taskmaster 로그
taskmaster.log
tm.log

# ================================
# Cursor IDE 관련
# ================================

# Cursor IDE 개인 설정 파일들
.cursor/settings.json
.cursor/keybindings.json
.cursor/snippets/
.cursor/extensions.json
*/.cursor/settings.json
*/.cursor/keybindings.json
*/.cursor/snippets/
*/.cursor/extensions.json

# Cursor 워크스페이스 설정
.cursor-workspace
*.cursor-workspace

# Cursor MCP 설정 (API 키 포함으로 주의)
# 팀과 공유하려면 주석 해제
# !.cursor/mcp.json

# Cursor 규칙 파일들은 팀과 공유 (포함)
!.cursor/rules/

# Cursor 플러그인 캐시
.cursor-cache/
*/.cursor-cache/

# Cursor 임시 파일들
*.cursor-tmp
.cursor-tmp/

# ================================
# Windsurf IDE 관련
# ================================

# Windsurf IDE 개인 설정 파일들
.windsurf/settings.json
.windsurf/keybindings.json
.windsurf/snippets/
.windsurf/extensions.json
*/.windsurf/settings.json
*/.windsurf/keybindings.json
*/.windsurf/snippets/
*/.windsurf/extensions.json

# Windsurf MCP 설정 (API 키 포함으로 주의)
# 팀과 공유하려면 주석 해제
# !.windsurf/mcp.json

# Windsurf 규칙 파일들은 팀과 공유 (포함)
!.windsurf/rules/

# Windsurf 플러그인 캐시
.windsurf-cache/
*/.windsurf-cache/

# Windsurf 임시 파일들
*.windsurf-tmp
.windsurf-tmp/

